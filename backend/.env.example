PROJECT_NAME="Hierarchical Task Management System"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Database Configuration
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="12345678"
POSTGRES_DB="hierarchy_db"

# JWT Authentication Security (Generate using: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY="f7390bca11883501a39cd52e7acb9d5c581e289bf443f651664c399a918a1a98"
ALGORITHM="HS256"
# Token validity: 720 minutes = 12 hours (recommended for private network workstations)
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Private Network Brute-Force Rate Limiting
RATE_LIMIT_LOGIN_MAX_ATTEMPTS=5
RATE_LIMIT_LOGIN_LOCKOUT_MINUTES=15

# Initial Super Admin Seed (Change upon initial private network deployment)
FIRST_SUPER_ADMIN_EMAIL="littadkt@gmail.com"
FIRST_SUPER_ADMIN_PASSWORD="Makeitfast@123"
FIRST_SUPER_ADMIN_NAME="Primary Super Admin"

# Network Host Configuration (0.0.0.0 allows other computers on private network to access)
HOST="0.0.0.0"
PORT=8000

# Allowed CORS Origins (Matches all private subnets 192.168.x.x, 10.x.x.x, 172.16-31.x.x, and local hostnames by default)
# Example: BACKEND_CORS_ORIGINS=["http://localhost:3000","http://192.168.100.84:3000"]

# File Attachments Storage
UPLOAD_DIR="uploads"
ATTACHMENTS_DIR="uploads/attachments"
